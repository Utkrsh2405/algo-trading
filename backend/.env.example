# Copy to .env and fill in. Never commit the real .env file.
# Never paste broker API keys or secrets into an AI chat prompt.

# Postgres
POSTGRES_USER=algotrader
POSTGRES_PASSWORD=changeme
POSTGRES_DB=algotrading
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
SECRET_KEY=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# App
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# ── Zerodha Kite Connect (Phase 2 — leave blank to use MockBroker) ──────────
# Get your API key and secret from https://developers.kite.trade/
KITE_API_KEY=
KITE_API_SECRET=

# SEBI Algo-Order Compliance Tag (Phase 7)
# This is passed as the `tag` field on every algorithmic order.
# Zerodha limits this to 20 characters.
# ⚠ IMPORTANT: Verify the exact required format (AlgoID, tag prefix, etc.)
# against the current Kite Connect API docs AND the applicable SEBI circular
# before placing any live orders. Regulatory requirements change over time.
KITE_ALGO_TAG=
